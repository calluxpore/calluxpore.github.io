---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/" xmlns:webfeeds="http://webfeeds.org/rss/1.0">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <title type="html">{{ site.title | xml_escape }}</title>
  {% if site.description %}
    <subtitle>{{ site.description | xml_escape }}</subtitle>
  {% endif %}
  <icon>{{ '/_assets/images/icon.png' | absolute_url }}</icon>
  <logo>{{ '/_assets/images/icon.png' | absolute_url }}</logo>
  <image>
    <url>{{ '/_assets/images/icon.png' | absolute_url }}</url>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url }}</link>
  </image>
  {% for post in site.posts limit:30 %}
    <entry>
      <title type="html">{{ post.title | xml_escape }}</title>
      <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}"/>
      <published>{{ post.date | date_to_xmlschema }}</published>
      <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
      <id>{{ post.id | absolute_url }}</id>
      {% assign full_content = post.content | replace: 'src="/', 'src="https://calluxpore.github.io/' %}
      <content type="html" xml:base="{{ post.url | absolute_url }}">
        {% if post.image %}
          &lt;p&gt;&lt;img src=&quot;{{ post.image | absolute_url }}&quot; alt=&quot;{{ post.title | xml_escape }}&quot; class=&quot;webfeed-default-thumbnail&quot; style=&quot;max-width:100%; border-radius:8px; margin-bottom:1.5rem;&quot; /&gt;&lt;/p&gt;
        {% endif %}
        {{ full_content | xml_escape }}
      </content>
      {% if post.author %}
        <author><name>{{ post.author | xml_escape }}</name></author>
      {% endif %}
      {% for category in post.categories %}
        <category term="{{ category | xml_escape }}"/>
      {% endfor %}
      {% if post.image %}
        <webfeeds:cover image="{{ post.image | absolute_url }}" />
        <media:thumbnail url="{{ post.image | absolute_url }}" width="1200" height="630" />
        <media:content url="{{ post.image | absolute_url }}" medium="image" type="image/png" width="1200" height="630" isDefault="true" />
      {% endif %}
    </entry>
  {% endfor %}
</feed>
